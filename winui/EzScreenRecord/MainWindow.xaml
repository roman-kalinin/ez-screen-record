<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EzScreenRecord.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Title bar. ExtendsContentIntoTitleBar makes this Grid the caption
            area; SetTitleBar() in the code-behind marks the draggable part.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="36" Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Pulsing while recording, so the state is obvious even when the
                 window is glanced at rather than read. -->
            <Ellipse x:Name="RecDot"
                     Grid.Column="0"
                     Width="8" Height="8"
                     Fill="#e81123"
                     Margin="0,0,8,0"
                     Visibility="Collapsed"
                     VerticalAlignment="Center">
                <Ellipse.Resources>
                    <Storyboard x:Name="RecPulse" RepeatBehavior="Forever">
                        <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="RecDot"
                            Storyboard.TargetProperty="Opacity">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="0.35" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </Ellipse.Resources>
            </Ellipse>

            <TextBlock Grid.Column="1"
                       Text="Ez Screen Record"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" />

            <!-- Window chrome. Drawn ourselves because the caption area is
                 extended into; these must sit outside the drag region. -->
            <StackPanel x:Name="ChromeButtons"
                        Grid.Column="3"
                        Orientation="Horizontal">
                <Button x:Name="PinButton"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="OnTogglePin"
                        AutomationProperties.Name="Keep on top"
                        ToolTipService.ToolTip="Keep on top">
                    <FontIcon x:Name="PinIcon" FontSize="12" />
                </Button>
                <Button Style="{StaticResource ChromeButtonStyle}"
                        Click="OnMinimize"
                        AutomationProperties.Name="Minimize window"
                        ToolTipService.ToolTip="Minimize">
                    <FontIcon x:Name="MinimizeIcon" FontSize="12" />
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="OnClose"
                        AutomationProperties.Name="Close window"
                        ToolTipService.ToolTip="Close">
                    <FontIcon x:Name="CloseIcon" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stage: the live 16:9 preview, vertically centred so resizing never
             leaves a dead band beneath it. -->
        <ScrollViewer Grid.Row="1" Padding="12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" VerticalAlignment="Center">
                <ContentPresenter x:Name="StageHost" HorizontalAlignment="Stretch" />

                <!-- Image overlays. Only rendered when there are any: an empty
                     list is just noise above the stage. -->
                <ItemsControl x:Name="ImageList"
                              Visibility="Collapsed"
                              MaxWidth="640"
                              HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- The control bar. Everything lives here or in a flyout off it;
             there are deliberately no settings cards on the main surface. -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="12,10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="LeftControls"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center" />

                <TextBlock x:Name="ElapsedLabel"
                           Grid.Column="1"
                           Visibility="Collapsed"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="00:00" />

                <StackPanel x:Name="Transport"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Countdown scrim -->
        <Grid x:Name="CountdownScrim"
              Grid.RowSpan="3"
              Background="#B8000000"
              Visibility="Collapsed">
            <TextBlock x:Name="CountdownText"
                       FontSize="120"
                       FontWeight="ExtraLight"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Toasts, top-end so they never sit over the record button. -->
        <StackPanel x:Name="ToastHost"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,40,12,0"
                    Spacing="8"
                    MaxWidth="380" />
    </Grid>
</Window>
