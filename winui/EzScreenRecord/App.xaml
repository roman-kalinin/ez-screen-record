<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EzScreenRecord.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Spacing scale. Kept as resources rather than literals so the
                whole app can be tightened or loosened in one place, and so
                nested layouts stay on a consistent rhythm.
            -->
            <x:Double x:Key="GapXS">4</x:Double>
            <x:Double x:Key="GapS">8</x:Double>
            <x:Double x:Key="GapM">12</x:Double>
            <x:Double x:Key="GapL">20</x:Double>
            <x:Double x:Key="GapXL">32</x:Double>

            <Thickness x:Key="PagePadding">24,16,24,24</Thickness>

            <!-- Height of the custom title bar, in DIPs. Matches the Electron
                 app's TITLEBAR_HEIGHT so both versions feel the same. -->
            <x:Double x:Key="TitleBarHeight">48</x:Double>

            <!-- A card surface that reads correctly on Mica in both themes.
                 Solid backgrounds would defeat the backdrop entirely. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Title-bar chrome buttons: flat, square, no border, so they read
                 as window chrome rather than as content. -->
            <Style x:Key="ChromeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>

            <!-- Round 40px control-bar button, the Meet/Zoom idiom. -->
            <Style x:Key="RoundButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
