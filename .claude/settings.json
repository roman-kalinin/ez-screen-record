{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run build:main)",
      "Bash(npm run build:renderer)",
      "Bash(npm install:*)",
      "Bash(npx tsc:*)",
      "Bash(node:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree list)",
      "Bash(mkdir:*)",
      "Bash(rm -f:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  }
}
