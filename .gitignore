node_modules/
dist/
dist-main/
dist_electron/
*.log
.DS_Store

# Packaged installers.
release/
.ffmpeg-tmp/

# The bundled ffmpeg is a ~150MB binary fetched by `npm run fetch:ffmpeg`;
# the README explaining which build to use is tracked, the binary is not.
resources/ffmpeg/*
!resources/ffmpeg/README.md

# Claude Code agent worktrees (local scratch, not project content).
.claude/worktrees/

# Native audio-helper build artifacts
native/audio-helper/*.exe
native/audio-helper/*.obj

# Per-architecture macOS ffmpeg binaries (fetched by tools/fetch-ffmpeg.mjs).
resources/ffmpeg-mac-*/
